{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zconfig.dev/contracts/inspection.schema.json",
  "title": "zconfig Source Inspection v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_path"],
      "properties": {
        "source_path": { "type": "string", "minLength": 1 },
        "schema_path": { "type": "string", "minLength": 1 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_digest", "byte_length", "node_count", "settings"],
      "properties": {
        "source_digest": { "$ref": "#/$defs/digest" },
        "byte_length": { "type": "integer", "minimum": 0, "maximum": 10485760 },
        "node_count": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "settings": {
          "type": "array",
          "maxItems": 100000,
          "items": { "$ref": "#/$defs/setting" }
        }
      }
    }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "value", "sensitivity"],
      "properties": {
        "path": { "type": "string" },
        "value": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["visibility", "value"],
              "properties": {
                "visibility": { "const": "plain" },
                "value": true
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["visibility", "secret_ref", "value_type", "fingerprint"],
              "properties": {
                "visibility": { "const": "redacted" },
                "secret_ref": { "type": "string" },
                "value_type": { "enum": ["string", "number", "integer", "boolean", "null", "array", "object"] },
                "fingerprint": { "type": "string", "pattern": "^hmac-sha256:[0-9a-f]{64}$" }
              }
            }
          ]
        },
        "sensitivity": { "enum": ["normal", "schema_sensitive", "suspected_sensitive"] },
        "title": { "type": "string" },
        "description": { "type": "string" }
      }
    }
  }
}
