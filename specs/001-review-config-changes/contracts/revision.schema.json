{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zconfig.dev/contracts/revision.schema.json",
  "title": "zconfig Proposal Revision v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposal_id", "base_revision", "source_digest", "allowed_change_item_ids", "comments", "proposal"],
      "properties": {
        "proposal_id": { "type": "string" },
        "base_revision": { "type": "integer", "minimum": 1 },
        "source_digest": { "$ref": "#/$defs/digest" },
        "allowed_change_item_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "comments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/comment" } },
        "proposal": { "$ref": "proposal.schema.json" },
        "source_context": { "type": "object" },
        "authorized_secrets": { "type": "object" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposal_id", "base_revision", "source_digest", "proposal", "resolved_comment_ids"],
      "properties": {
        "proposal_id": { "type": "string" },
        "base_revision": { "type": "integer", "minimum": 1 },
        "source_digest": { "$ref": "#/$defs/digest" },
        "proposal": { "$ref": "proposal.schema.json" },
        "resolved_comment_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_proposal", "candidate_proposal", "allowed_change_item_ids", "resolved_comment_ids"],
      "properties": {
        "active_proposal": { "$ref": "proposal.schema.json" },
        "candidate_proposal": { "$ref": "proposal.schema.json" },
        "allowed_change_item_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "resolved_comment_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "comment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comment_id", "change_id", "body"],
      "properties": {
        "comment_id": { "type": "string" },
        "change_id": { "type": "string" },
        "body": { "type": "string", "minLength": 1, "maxLength": 65536 }
      }
    }
  }
}
