{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zconfig.dev/contracts/proposal.schema.json",
  "title": "zconfig Change Proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposal_id", "revision", "source_digest", "created_at", "items"],
  "properties": {
    "proposal_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "revision": { "type": "integer", "minimum": 1 },
    "source_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "producer": { "type": "string", "maxLength": 256 },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/changeItem" }
    }
  },
  "$defs": {
    "changeItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["change_id", "path", "operation", "explanation"],
      "properties": {
        "change_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "path": { "type": "string" },
        "operation": { "enum": ["add", "replace", "remove"] },
        "expected_old": true,
        "proposed_value": true,
        "explanation": { "type": "string", "maxLength": 8192 }
      },
      "allOf": [
        {
          "if": { "properties": { "operation": { "const": "add" } }, "required": ["operation"] },
          "then": { "required": ["proposed_value"], "not": { "required": ["expected_old"] } }
        },
        {
          "if": { "properties": { "operation": { "const": "replace" } }, "required": ["operation"] },
          "then": { "required": ["expected_old", "proposed_value"] }
        },
        {
          "if": { "properties": { "operation": { "const": "remove" } }, "required": ["operation"] },
          "then": { "required": ["expected_old"], "not": { "required": ["proposed_value"] } }
        }
      ]
    }
  }
}
